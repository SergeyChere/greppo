{
  "id": "nav",
  "word": "ROBOT",
  "title": "Valley of Files",
  "lessons": [
    {
      "id": "nav.look",
      "title": "pwd + ls — look around",
      "letters": [
        0
      ],
      "tasks": [
        {
          "id": "nav.look.1",
          "show": "Where am I? Type <b>pwd</b> — print working directory",
          "cmd": "pwd",
          "check": {
            "ran": "pwd"
          }
        },
        {
          "id": "nav.look.2",
          "show": "What is here? Type <b>ls</b> — list files and folders",
          "cmd": "ls",
          "check": {
            "ran": "ls"
          }
        },
        {
          "id": "nav.look.3",
          "ask": "Which command shows where you are? Type it.",
          "cmd": "pwd",
          "check": {
            "ran": "pwd"
          }
        }
      ]
    },
    {
      "id": "nav.move",
      "title": "cd — move between folders",
      "letters": [
        1
      ],
      "tasks": [
        {
          "id": "nav.move.1",
          "show": "Go into the folder games. Type <b>cd games</b> — change directory",
          "cmd": "cd games",
          "check": {
            "cd": "~/games"
          }
        },
        {
          "id": "nav.move.2",
          "show": "Go up one folder, back toward home. Type <b>cd ..</b> (.. means \"the folder above\")",
          "cmd": "cd ..",
          "check": {
            "ranArg": [
              "cd",
              ".."
            ]
          }
        },
        {
          "id": "nav.move.3",
          "ask": "Go into the folder pictures",
          "cmd": "cd pictures",
          "check": {
            "cd": "~/pictures"
          }
        },
        {
          "id": "nav.move.4",
          "ask": "Which command takes you to your home folder? Type it.",
          "cmd": "cd ~",
          "check": {
            "cdHome": true
          }
        }
      ]
    },
    {
      "id": "nav.paths",
      "title": "paths — two ways to say where",
      "letters": [],
      "tasks": [
        {
          "id": "nav.paths.1",
          "show": "A <b>relative</b> path starts from where you are now. From home, type <b>cd games</b> to go into games",
          "cmd": "cd games",
          "check": {
            "cd": "~/games"
          }
        },
        {
          "id": "nav.paths.2",
          "show": "An <b>absolute</b> path starts with <b>~</b> (your home) and works from anywhere. Type <b>cd ~/box</b>",
          "cmd": "cd ~/box",
          "check": {
            "cd": "~/box"
          }
        },
        {
          "id": "nav.paths.3",
          "ask": "Using an absolute path (start with ~), go into ~/pictures",
          "cmd": "cd ~/pictures",
          "check": {
            "cd": "~/pictures"
          }
        },
        {
          "id": "nav.paths.4",
          "ask": "Go back home with the short absolute path. Type the command.",
          "cmd": "cd ~",
          "check": {
            "cdHome": true
          }
        }
      ]
    },
    {
      "id": "nav.read",
      "title": "cat — read files",
      "letters": [
        2
      ],
      "tasks": [
        {
          "id": "nav.read.1",
          "show": "Read the file welcome.txt. Type <b>cat welcome.txt</b>. The .txt means it is a text file",
          "cmd": "cat welcome.txt",
          "check": {
            "cat": "~/welcome.txt"
          }
        },
        {
          "id": "nav.read.2",
          "ask": "Read the file games/secret.txt",
          "cmd": "cat games/secret.txt",
          "check": {
            "cat": "~/games/secret.txt"
          }
        },
        {
          "id": "nav.read.3",
          "ask": "Which command reads a file? Use it to read box/clue.txt",
          "cmd": "cat box/clue.txt",
          "check": {
            "cat": "~/box/clue.txt"
          }
        }
      ]
    },
    {
