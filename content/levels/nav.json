            "ran": "tree"
          }
        },
        {
          "id": "nav.map.2",
          "ask": "From your home folder, go into box and then toys in one step: cd box/toys",
          "cmd": "cd box/toys",
          "check": {
            "cd": "~/box/toys"
          }
        },
        {
          "id": "nav.map.3",
          "ask": "Which one-word command shows the whole tree? Type it.",
          "cmd": "tree",
          "check": {
            "ran": "tree"
          }
        }
      ]
    },
