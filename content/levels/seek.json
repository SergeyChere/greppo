    {
      "id": "seek.star",
      "title": "* the star (wildcards)",
      "letters": [
        2
      ],
      "tasks": [
        {
          "id": "seek.star.1",
          "show": "List only the text files here. (* means anything)",
          "cmd": "ls *.txt",
          "check": {
            "argHas": [
              "ls",
              "*"
            ]
          }
        },
        {
          "id": "seek.star.2",
          "ask": "Find files with toy in the name, using the star.",
          "cmd": "find *toy*",
          "check": {
            "and": [
              {
                "argHas": [
                  "find",
                  "*"
                ]
              },
              {
                "out": [
                  "find",
                  "toy"
                ]
              }
            ]
          }
        },
        {
          "id": "seek.star.3",
          "ask": "From home, go into box then toys (an old skill!): cd box/toys",
          "cmd": "cd box/toys",
          "check": {
            "cd": "~/box/toys"
          }
        }
      ]
    },
