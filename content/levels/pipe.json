                  "sort"
                ]
              }
            }
          ]
        },
        {
          "id": "pipe.check.2",
          "ask": "Sort and remove repeats in library/animals.txt",
          "cmd": "cat library/animals.txt | sort | uniq",
          "check": {
            "typed": [
              "sort",
